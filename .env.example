# 供应商三件套：改这三行就能换任意 OpenAI 兼容平台，代码不用动
# （三件套必须来自同一家平台！Key 和接口地址不配对就会报 401）

# --- 方案A：智谱 BigModel（glm-4.7-flash 免费）---
LLM_API_KEY=到这里领取：https://open.bigmodel.cn
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash

# --- 方案B：DeepSeek 官方（充 10 元用很久）---
# LLM_API_KEY=sk-到这里创建：https://platform.deepseek.com
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
